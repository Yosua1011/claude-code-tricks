# .claudeignore - Exclude unnecessary files from Claude Code context
# This optimizes performance and focuses on actual source code

# Virtual Environments
venv/
.venv/
env/
ENV/

# Python Cache Files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Testing Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type Checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Distribution / Packaging
build/
dist/
*.egg-info/
.eggs/

# Data Files (for ML projects)
data/raw/
data/processed/
*.csv
*.parquet
*.h5
*.hdf5

# Model Files
*.pkl
*.joblib
*.pt
*.pth
*.ckpt

# IDE Settings
.vscode/
.idea/
*.swp
*.swo
*~

# OS Files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment Files
.env
.env.local
.env.*.local
